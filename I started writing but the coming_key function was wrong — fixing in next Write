def build_coming_soon(key: str) -> dict:
    meta = COMING_SOON[key]
    return {
        "key": key,
        "title": meta["title"],
        "desc": meta["desc"],
        "glyph": meta["glyph"],
        "cls": meta["cls"],
        "family": next(f["name"] for f in FAMILIES if key in f["courses"]),
        "coming_soon": True,
        "chapters": [],
        "sections": 0,
    }


def course_summary(course: dict) -> dict:
    """课程卡片 / 侧栏需要的元信息（不含正文）。"""
    chapters = [
        {
            "n": c["n"],
            "slug": str(c["n"]),
            "title": c["title"],
            "url": f"/course/{c['course']}/{c['n']}/",
            "sections": c.get("sec_meta", []),
        }
        for c in course["chapters"]
    ]
    return {
        "key": coming_key(course) if is_coming(course) else course["key"],
        "title": course["title"],
        "desc": course.get("desc", "") or "",
        "glyph": course.get("glyph", "·"),
        "cls": course.get("cls", "b1"),
        "family": course.get("family", ""),
        "coming_soon": is_coming(course),
        "modules": course.get("modules", []),
        "chapters": chapters,
        "section_count": sum(len(c["sections"]) for c in course["chapters"]),
    }


def is_coming(course: dict) -> bool:
    return bool(course.get("coming_soon"))


